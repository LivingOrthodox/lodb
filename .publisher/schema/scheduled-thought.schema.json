{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "The civil date this thought is shown."
    },
    "locale": {
      "default": "en",
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "quote": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "minLength": 1,
      "maxLength": 2000,
      "description": "The quotation or reflection text."
    },
    "author": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "minLength": 1,
      "maxLength": 200,
      "description": "The person who actually wrote or said it."
    },
    "attribution": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "minLength": 1,
      "maxLength": 500,
      "description": "Full attribution, e.g. work and section."
    },
    "kind": {
      "default": "quotation",
      "type": "string",
      "enum": [
        "quotation",
        "originalReflection"
      ]
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "originalPublicationDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "description": "Gregorian civil date (YYYY-MM-DD), year 1900-2199. Not a timestamp."
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceIds": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "reflection": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "practicalAction": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "background": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^assets\\/(?:[a-z0-9][a-z0-9_-]*\\/)*[a-z0-9][a-z0-9_-]*\\.(?:jpg|heic|webp|png)$",
              "description": "Path of a licensed image in the repository, e.g. assets/backgrounds/x.jpg."
            },
            "altText": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
              "minLength": 1,
              "maxLength": 300
            },
            "focalPoint": {
              "default": {
                "x": 0.5,
                "y": 0.5
              },
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ]
            },
            "photographer": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
              "minLength": 1,
              "maxLength": 200
            },
            "license": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
              "minLength": 1,
              "maxLength": 200
            },
            "licenseUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::443)?(?:[/?][!-\"$-\\[\\]-~]*)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attributionText": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "image",
            "altText",
            "photographer",
            "license",
            "attributionText"
          ],
          "title": "ScheduledBackground"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "default": "published",
      "type": "string",
      "enum": [
        "published",
        "withdrawn"
      ]
    },
    "isDevelopmentContent": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "date",
    "quote",
    "author",
    "attribution",
    "sourceIds"
  ],
  "title": "ScheduledThought",
  "$id": "urn:living-orthodox:contract:v1:scheduled-thought"
}
