{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recordKey": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:thought|lesson|calendar):[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the record's canonical JSON; any edit invalidates the approval."
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "changesRequested"
      ]
    },
    "reviewerRole": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "minLength": 1,
      "maxLength": 100
    },
    "reviewerReference": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Opaque reference to the reviewer's authorization record. No names."
    },
    "authority": {
      "type": "string",
      "enum": [
        "doctrine",
        "commentary",
        "jurisdictionalCustom",
        "pastoralGuidance",
        "devotionalTradition",
        "historicalAccount"
      ]
    },
    "reviewedOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Gregorian civil date (YYYY-MM-DD), year 1900-2199. Not a timestamp."
    },
    "evidenceReference": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "required": [
    "recordKey",
    "digest",
    "status",
    "reviewerRole",
    "reviewerReference",
    "authority",
    "reviewedOn",
    "evidenceReference"
  ],
  "title": "EditorialReview",
  "$id": "urn:living-orthodox:contract:v1:editorial-review"
}
